# Copie para .env e preencha. O .env nunca vai para o git (.gitignore).

# --- MACLE Controle (login da tela: usuário, senha e terminal) ---
# Para a demo, o simulador (mock_macle/servidor.py) aceita estas mesmas credenciais.
MACLE_USUARIO=demo
MACLE_SENHA=troque_esta_senha
MACLE_TERMINAL=001
# Lojas, servidores do MACLE e CNPJs. Sem este arquivo, usa data/lojas.exemplo.json (simulador).
LOJAS_ARQUIVO=data/lojas.json

# --- NFD: pesos usados nos dados de transporte (tudo numa caixa) ---
PESO_POR_PAR=0.700
PESO_CAIXA=0.200

# --- Gmail (IMAP com senha de app: https://myaccount.google.com/apppasswords) ---
# Deixe GMAIL_APP_PASSWORD vazio para gravar os rascunhos em saida/rascunhos/*.eml em vez do Gmail.
GMAIL_USER=sua_conta@gmail.com
GMAIL_APP_PASSWORD=

# --- Telegram (Bot API: crie o bot com o @BotFather) ---
# Deixe TELEGRAM_BOT_TOKEN vazio para gravar as mensagens em saida/telegram.log em vez de enviar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Execução ---
INTERVALO_MIN=60
HTTP_TIMEOUT=15
TENTATIVAS=3
