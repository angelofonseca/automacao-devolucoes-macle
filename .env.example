# Copie para .env e preencha. O .env nunca vai para o git (.gitignore).

# --- ERP (API HTTP com login por usuário/senha e cookie de sessão) ---
# Para a demo, o ERP simulado (mock_erp/servidor.py) usa estas mesmas credenciais.
ERP_URL=http://127.0.0.1:8080
ERP_USUARIO=demo
ERP_SENHA=troque_esta_senha

# --- Gmail (IMAP com senha de app: https://myaccount.google.com/apppasswords) ---
# Deixe GMAIL_APP_PASSWORD vazio para gravar os rascunhos em saida/rascunhos/*.eml em vez do Gmail.
GMAIL_USER=sua_conta@gmail.com
GMAIL_APP_PASSWORD=

# --- Telegram (Bot API: crie o bot com o @BotFather) ---
# Deixe TELEGRAM_BOT_TOKEN vazio para gravar as mensagens em saida/telegram.log em vez de enviar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Execução ---
# Intervalo do agendamento (minutos) quando roda sem --once.
INTERVALO_MIN=60
# Tempo máximo de cada requisição de rede (segundos).
HTTP_TIMEOUT=10
# Tentativas em falha de rede ou HTTP 5xx antes de desistir.
TENTATIVAS=3
