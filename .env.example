# Copie para .env e preencha. O .env nunca vai para o git (.gitignore).

# --- MACLE Controle (login da tela: usuário, senha e terminal) ---
# Para a demo, o simulador (mock_macle/servidor.py) aceita estas mesmas credenciais.
MACLE_USUARIO=demo
MACLE_SENHA=troque_esta_senha
MACLE_TERMINAL=001
# Lojas, servidores do MACLE e CNPJs. Sem este arquivo, usa data/lojas.exemplo.json (simulador).
LOJAS_ARQUIVO=data/lojas.json

# --- Gmail (obrigatório): IMAP com senha de app, https://myaccount.google.com/apppasswords ---
# O rascunho do e-mail à fábrica é gravado na pasta Rascunhos desta conta. Nada é enviado.
GMAIL_USER=sua_conta@gmail.com
GMAIL_APP_PASSWORD=

# --- Telegram (obrigatório): crie o bot com o @BotFather ---
# TELEGRAM_CHAT_ID: mande uma mensagem ao bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates
# (o número fica em "chat": {"id": ...}). Só este chat registra casos e recebe os resumos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Execução ---
INTERVALO_MIN=60
HTTP_TIMEOUT=15
TENTATIVAS=3
